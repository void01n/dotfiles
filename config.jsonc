{"layer":"top","position":"top","height":34,"margin-top":8,"margin-left":150,"margin-right":150,"spacing":0,"modules-left":["clock","tray"],"modules-center":["niri/workspaces"],"modules-right":["battery","pulseaudio","network","cpu","memory","clock#date","custom/power"],"battery":{"format":"{icon} {capacity}%","format-icons":["","","","",""],"tooltip-format":"{time} remaining"},"niri/workspaces":{"format":"{index}","on-click":"activate","active-only":false,"all-outputs":false},"clock":{"format":"{:%I:%M %p}","tooltip":false},"clock#date":{"format":"{:%a %d}","tooltip":false},"pulseaudio":{"format":"{icon}","format-muted":"","format-icons":{"default":["","",""]},"on-click":"pavucontrol","scroll-step":5,"tooltip-format":"{volume}%"},"network":{"format-wifi":"","format-ethernet":"","format-disconnected":"󰤭","tooltip-format":"{essid} {ipaddr}"},"cpu":{"format":" {usage}%","tooltip":false},"memory":{"format":" {percentage}%","tooltip-format":"{used:0.1f}G / {total:0.1f}G"},"custom/power":{"format":"⏻","on-click":"~/.config/waybar/scripts/power.sh","tooltip":false}}
