{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // This allows fastfetch to find the asset from any folder
        "source": "~/.config/fastfetch/ascii.txt",
        "type": "file",
        "color": {
            "1": "#F3A2BB",
            "2": "#EEAE7B",
            "3": "#B5C77D",
            "4": "#6DD3C0",
            "5": "#80C6F8",
            "6": "#C7AFF5"
        }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "shell",
        "display",
        "de",
        "wm",
        "icons",
        "terminal",
        "cpu",
        "gpu",
        "memory"
    ]
}
